ODOO_URL=https://your-company.odoo.com
ODOO_DB=your-db
ODOO_API_KEY=
PORT=3000

# New for the helpdesk webhook:
# Shared secret; set the Odoo webhook URL to https://<host>/webhooks/odoo/helpdesk?token=<this value>
WEBHOOK_TOKEN=
# Optional: where the ticket cache is stored
CACHE_PATH=helpdesk-cache.json
